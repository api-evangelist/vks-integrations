            "params": [
              {
                "name": "work_order_id",
                "value": "",
                "type": "path",
                "description": "Unique work order identifier"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve all operation steps for a work order, including their status and production data."
        }
      ]
    }
  ],
  "bundled": true
